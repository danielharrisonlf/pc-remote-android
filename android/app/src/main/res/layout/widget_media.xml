<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget (MediaWidget): what the PC plays and three buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="16dp"
  android:paddingEnd="8dp">
  <LinearLayout
    android:id="@+id/widget_text"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="vertical">
    <TextView
      android:id="@+id/widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:text="@string/app_name"
      android:textColor="@color/widget_text"
      android:textSize="15sp" />
    <TextView
      android:id="@+id/widget_subtitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/widget_idle"
      android:textColor="@color/widget_text_secondary"
      android:textSize="12sp" />
  </LinearLayout>
  <ImageButton
    android:id="@+id/widget_previous"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/widget_previous"
    android:padding="10dp"
    android:scaleType="fitCenter"
    android:src="@drawable/ic_skip_back"
    android:tint="@color/widget_text" />
  <ImageButton
    android:id="@+id/widget_toggle"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/widget_play"
    android:padding="10dp"
    android:scaleType="fitCenter"
    android:src="@drawable/ic_play"
    android:tint="@color/widget_accent" />
  <ImageButton
    android:id="@+id/widget_next"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    android:contentDescription="@string/widget_next"
    android:padding="10dp"
    android:scaleType="fitCenter"
    android:src="@drawable/ic_skip_forward"
    android:tint="@color/widget_text" />
</LinearLayout>
